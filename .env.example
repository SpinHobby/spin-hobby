# The storefront, checkout and admin talk to one backend: the Spin Hobby API (NestJS,
# SpinHobby/spin-hobby-server). This is the only setting the browser build needs.
# Local development: run `npm run dev:local` in spin-hobby-server, which serves http://localhost:8080.
VITE_API_URL=http://localhost:8080

# Optional link overrides (see src/v3/links.ts)
# VITE_DISCORD_URL=https://discord.gg/your-permanent-invite
# VITE_EBAY_URL=https://www.ebay.ca/usr/spin-hobby
# VITE_SUPPORT_EMAIL=support@spinhobby.com

# Checkout reads the PayPal client ID from the API (/checkout/config).
# Only set this as a fallback, and it must match the server's PAYPAL_CLIENT_ID.
# VITE_PAYPAL_CLIENT_ID=
